DATABASE_URL=sqlite:///./radar.db
FRONTEND_ORIGIN=http://localhost:3000

# OpenRouter: optional AI-generated learner explanations
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Africa's Talking: optional SMS/USSD provider
AT_USERNAME=sandbox
AT_API_KEY=
AT_ENABLED=false
AT_SENDER_ID=

# Airtime reward for learners who recover from a misconception (needs AT_ENABLED=true and a key)
AT_AIRTIME_ENABLED=false
AT_AIRTIME_AMOUNT=500
AT_AIRTIME_CURRENCY=UGX

# Optional: require ?key=... on the USSD callback URL (the web simulator is exempt)
USSD_CALLBACK_SECRET=

# Optional shared secrets for Africa's Talking async callbacks. Add ?key=VALUE to each
# callback URL configured in your Africa's Talking dashboard.
AT_SMS_CALLBACK_SECRET=
AT_AIRTIME_CALLBACK_SECRET=
AT_USSD_EVENT_SECRET=

# Teacher bearer sessions expire after this many hours
SESSION_TTL_HOURS=12
